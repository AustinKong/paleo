"events": [Object(InputEventKey,"physical_keycode":4194309)]
}

keyboard_right_interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":46)]
}

gamepad_move_left={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":0,"axis_value":-1)]
}

gamepad_move_right={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":0,"axis_value":1)]
}

gamepad_move_up={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":1,"axis_value":-1)]
}

gamepad_move_down={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":1,"axis_value":1)]
}

gamepad_join={
"deadzone": 0.2,
"events": [Object(InputEventJoypadButton,"device":-1,"button_index":6)]
}

gamepad_interact={
"deadzone": 0.2,
"events": [Object(InputEventJoypadButton,"device":-1,"button_index":0)]
}

[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="Players"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
